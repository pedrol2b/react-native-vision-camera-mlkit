{
  "name": "react-native-vision-camera-mlkit",
  "version": "2.0.0",
  "description": "A React Native Vision Camera (v5, Nitro-based) plugin for Google ML Kit vision features. Ships text recognition (OCR) and barcode scanning today, each independently selectable to keep binary size down, for real-time frame processing and static images, with more ML Kit vision features (face detection, pose detection, and others) on the roadmap.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "app.plugin.js",
    "plugin",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/app/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-vision-camera-mlkit-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "specs": "nitrogen",
    "release": "release-it --only-version",
    "test": "jest"
  },
  "keywords": [
    "android",
    "ios",
    "ocr",
    "react-native",
    "barcode",
    "vision",
    "mlkit",
    "google-ml-kit",
    "vision-camera",
    "frame-processor",
    "machine-learning",
    "computer-vision",
    "react-native-module",
    "native-module",
    "image-processing",
    "camera",
    "text-detection",
    "text-recognition",
    "barcode-scanner",
    "barcode-scanning",
    "nitro",
    "expo",
    "config-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrol2b/react-native-vision-camera-mlkit.git"
  },
  "author": "Pedro Bueno <pedrolbb.e@gmail.com> (https://github.com/pedrol2b)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pedrol2b/react-native-vision-camera-mlkit/issues"
  },
  "homepage": "https://github.com/pedrol2b/react-native-vision-camera-mlkit#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@expo/config-plugins": "57.0.6",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "^0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "lefthook": "^2.0.3",
    "nitrogen": "0.36.1",
    "prettier": "^2.8.8",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.13",
    "react-native-nitro-modules": "0.36.1",
    "react-native-vision-camera": "^5.1.0",
    "release-it": "^19.0.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@expo/config-plugins": "^57.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-vision-camera": ">=5"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "undici": "6.28.0"
  },
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "plugin/**/*.js",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/types.ts",
      "!src/specs/**",
      "!plugin/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "codegenConfig": {
    "name": "VisionCameraMLKitSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs"
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "tools": [
      "eslint",
      "lefthook",
      "release-it",
      "jest"
    ],
    "version": "0.55.1"
  }
}
